APP_NAME=Workforce Attendance & Payroll API
APP_ENV=development
DEBUG=true
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5433/workforce
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
# Comma-separated browser origins allowed by FastAPI CORS\nCORS_ORIGINS=http://localhost:5173\n